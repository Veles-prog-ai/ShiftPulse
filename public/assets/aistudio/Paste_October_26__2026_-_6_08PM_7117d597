💻 2. Backend nadogradnja (server.ts)

U tvom backend-u moramo uvesti zvaničnu formulu za obračun zarada u Republici Srbiji. AI model (Gemini) sada dobija ulogu asistenta za unos (data-entry) koji čita ugovor, ali matematiku preuzima fiksni, nepogrešivi algoritamski kod.
Evo kako prepravljamo i proširujemo tvoj server.ts fajl:
typescript
// server.ts - TRANSFORMIŠI /API/LEGAL/ANALYZE-DOCUMENT ZA KNJIGOVODSTVENI PRO NIVOU

// 1. Zvanične zakonske poreske konstante (Ažurirano za zvanične knjigovodstvene standarde)
const POREZ_NA_ZARADE_STOPA = 0.10; // 10%
const DOPRINOSI_ZAPOSLENI = {
  pio: 0.14,        // 14%
  zdravstvo: 0.0515, // 5.15%
  nezaposlenost: 0.0075 // 0.75%
}; // Ukupno na teret radnika: 19.9%

const DOPRINOSI_POSLODAVAC = {
  pio: 0.10,        // 10%
  zdravstvo: 0.0515, // 5.15%
  nezaposlenost: 0.00 // Zakonski ukinuto na teret poslodavca
}; // Ukupno na teret poslodavca: 15.15%

// NEOPOREZIVI IZNOS (Prilagoditi zvaničnoj osnovici na dan obračuna)
const NEOPOREZIVI_IZNOS_OSNOVICE = 25000.00; 

// 2. Profesionalni Ledger Pro Obračunski Endpoint
app.post('/api/ledger/calculate-payroll', (req: Request, res: Response) => {
  try {
    const { brutoZarada, prekovremeniSati, nocniSati, satnicaObracun } = req.body;

    // Proračun uvećanja u skladu sa Zakonom o radu RS
    const osnovnaBrutoZarada = brutoZarada;
    const nocniRadUvecanje = nocniSati * (satnicaObracun * 0.26); // Minimum +26% po zakonu
    const prekovremeniRadUvecanje = prekovremeniSati * (satnicaObracun * 0.26); // Minimum +26%

    const ukupnaBrutoZarada = osnovnaBrutoZarada + nocniRadUvecanje + prekovremeniRadUvecanje;

    // MATEMATIKA OBRAČUNA PLATA (Srpski računovodstveni model)
    // Osnovica za porez se umanjuje za neoporezivi iznos
    const poreskaOsnovica = Math.max(0, ukupnaBrutoZarada - NEOPOREZIVI_IZNOS_OSNOVICE);
    const porezNaZaradu = poreskaOsnovica * POREZ_NA_ZARADE_STOPA;

    // Doprinosi na teret zaposlenog (Oduzimaju se od bruto plate)
    const pioZaposleni = ukupnaBrutoZarada * DOPRINOSI_ZAPOSLENI.pio;
    const zdravstvoZaposleni = ukupnaBrutoZarada * DOPRINOSI_ZAPOSLENI.zdravstvo;
    const nezaposlenostZaposleni = ukupnaBrutoZarada * DOPRINOSI_ZAPOSLENI.nezaposlenost;
    const ukupniDoprinosiZaposleni = pioZaposleni + zdravstvoZaposleni + nezaposlenostZaposleni;

    // NETO PLATA (Ono što ide radniku na tekući račun)
    const netoZarada = ukupnaBrutoZarada - porezNaZaradu - ukupniDoprinosiZaposleni;

    // Doprinosi na teret poslodavca (Dodatni trošak za firmu - Tvoj B2B klijent ovo želi da vidi!)
    const pioPoslodavac = ukupnaBrutoZarada * DOPRINOSI_POSLODAVAC.pio;
    const zdravstvoPoslodavac = ukupnaBrutoZarada * DOPRINOSI_POSLODAVAC.zdravstvo;
    const ukupniDoprinosiPoslodavac = pioPoslodavac + zdravstvoPoslodavac;

    // UKUPAN TROŠAK PLATE ZA FIRMU (Super-bruto / Bruto II)
    const ukupanTrosakZarade = ukupnaBrutoZarada + ukupniDoprinosiPoslodavac;

    res.json({
      success: true,
      obračun: {
        bruto: ukupnaBrutoZarada,
        neto: netoZarada,
        porez: porezNaZaradu,
        doprinosiRadnik: ukupniDoprinosiZaposleni,
        doprinosiFirma: ukupniDoprinosiPoslodavac,
        ukupnoZaIsplatuFirme: ukupanTrosakZarade,
        detaljiDoprinosa: {
          pioRadnik: pioZaposleni,
          zdravstvoRadnik: zdravstvoZaposleni,
          pioPoslodavac: pioPoslodavac,
          zdravstvoPoslodavac: zdravstvoPoslodavac
        }
      }
    });
  } catch (error) {
    res.status(500).json({ error: 'Greška u zvaničnom računovodstvenom proračunu.' });
  }
});

// 3. XML GENERATOR ENDPOINT ZA PORESKU UPRAVU (PPP-PD)
app.post('/api/ledger/generate-xml', (req: Request, res: Response) => {
  // Knjigovođe obožavaju ovo: Generisanje XML fajla koji direktno uvoze na sajt Poreske uprave (ePorezi)
  const { podaciOFirmi, radnici } = req.body;
  
  let xml = `<?xml version="1.0" encoding="UTF-8"?>\n<PodaciOPrimiocima>\n`;
  // Ovde skripta generiše strukturu u skladu sa XML šemom Poreske uprave Srbije
  xml += `  <PodaciOFirmi>\n    <PIB>${podaciOFirmi.pib}</PIB>\n  </PodaciOFirmi>\n`;
  xml += `</PodaciOPrimiocima>`;

  res.setHeader('Content-Type', 'application/xml');
  res.send(xml);
});
