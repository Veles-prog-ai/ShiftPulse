// Zvanični poreski parametri za Republiku Srbiju
const RECEPT_POREZ_STOPA = 0.10;
const RECEPT_NEOPOREZIVO = 25000.00;
const STRUCT_DOPRINOSI_RADNIK = { pio: 0.14, zdravstvo: 0.0515, nezaposlenost: 0.0075 };
const STRUCT_DOPRINOSI_FIRMA = { pio: 0.10, zdravstvo: 0.0515 };

// ==========================================
// 1. PAYROLL ENGINE & DB INTEGRATION
// ==========================================
app.post('/api/ledger/calculate-payroll', async (req: Request, res: Response): Promise<void> => {
  try {
    const { employeeId, brutoBaza, prekovremeniSati, nocniSati, satnica } = req.body;

    const nocniRadUvecanje = nocniSati * (satnica * 0.26);
    const prekovremeniUvecanje = prekovremeniSati * (satnica * 0.26);
    const ukupniBruto = brutoBaza + nocniRadUvecanje + prekovremeniUvecanje;

    const osnovicaZaPorez = Math.max(0, ukupniBruto - RECEPT_NEOPOREZIVO);
    const porez = osnovicaZaPorez * RECEPT_POREZ_STOPA;

    const pioR = ukupniBruto * STRUCT_DOPRINOSI_RADNIK.pio;
    const zdrR = ukupniBruto * STRUCT_DOPRINOSI_RADNIK.zdravstvo;
    const nezR = ukupniBruto * STRUCT_DOPRINOSI_RADNIK.nezaposlenost;
    const doprinosiRadnik = pioR + zdrR + nezR;

    const neto = ukupniBruto - porez - doprinosiRadnik;

    const pioP = ukupniBruto * STRUCT_DOPRINOSI_FIRMA.pio;
    const zdrP = ukupniBruto * STRUCT_DOPRINOSI_FIRMA.zdravstvo;
    const doprinosiFirma = pioP + zdrP;
    const ukupanTrosak = ukupniBruto + doprinosiFirma;

    res.json({
      success: true,
      obračun: {
        bruto: ukupniBruto,
        neto: neto,
        porez: porez,
        doprinosiRadnik,
        doprinosiFirma,
        ukupnoZaIsplatuFirme: ukupanTrosak,
        detaljiDoprinosa: { pioRadnik: pioR, zdravstvoRadnik: zdrR, pioPoslodavac: pioP, zdravstvoPoslodavac: zdrP }
      }
    });
  } catch (error: any) {
    res.status(500).json({ error: 'Greška u proračunu zarada.', details: error.message });
  }
});

