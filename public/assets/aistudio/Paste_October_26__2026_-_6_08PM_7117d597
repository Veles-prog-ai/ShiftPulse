app.post('/api/ledger/generate-xml', (req: Request, res: Response) => {
  try {
    const { firma, radnici } = req.body;

    let xml = `<?xml version="1.0" encoding="UTF-8"?>\n`;
    xml += `<pripravaPrijave xmlns="http://purs.gov.rs">\n`;
    xml += `  <PodaciOPrijavi>\n`;
    xml += `    <KlijentPIB>${firma.pib}</KlijentPIB>\n`;
    xml += `    <TipPrijave>1</TipPrijave>\n`; // 1 = Redovna prijava
    xml += `    <ObracunskiPeriod>${new Date().toISOString().slice(0, 7)}</ObracunskiPeriod>\n`;
    xml += `  </PodaciOPrijavi>\n`;
    xml += `  <PririociPrihoda>\n`;

    radnici.forEach((r: any, index: number) => {
      if (!r.kompletan) return;
      xml += `    <Primalac>\n`;
      xml += `      <RedniBroj>${index + 1}</RedniBroj>\n`;
      xml += `      <Identifikator>${r.jmbg}</Identifikator>\n`;
      xml += `      <TipIdentifikatora>1</TipIdentifikatora>\n`; // 1 = JMBG
      xml += `      <ImePrezime>${r.ime}</ImePrezime>\n`;
      xml += `      <SifraSVP>101000</SifraSVP>\n`; // 101000 = Šifra vrste prihoda za zaradu iz radnog odnosa
      xml += `      <SifraOpstine>${firma.opstina_kod || '011'}</SifraOpstine>\n`;
      xml += `      <Bruto>${Math.round(r.obracun.bruto).toFixed(2)}</Bruto>\n`;
      xml += `      <Porez>${Math.round(r.obracun.porez).toFixed(2)}</Porez>\n`;
      xml += `      <Doprinosi>${Math.round(r.obracun.doprinosiRadnik).toFixed(2)}</Doprinosi>\n`;
      xml += `    </Primalac>\n`;
    });

    xml += `  </PririociPrihoda>\n`;
    xml += `</pripravaPrijave>`;

    res.setHeader('Content-Type', 'application/xml');
    res.setHeader('Content-Disposition', `attachment; filename="PPP-PD_${firma.pib}_${Date.now()}.xml"`);
    res.send(xml);
  } catch (err: any) {
    res.status(500).send(`<error>Neuspešno generisanje poreskog XML-a: ${err.message}</error>`);
  }
});

