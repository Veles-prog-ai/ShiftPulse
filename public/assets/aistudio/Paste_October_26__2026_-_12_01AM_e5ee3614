
RECEPT 1: ARHITEKTURA I BACKEND ENDPOINT ZA AI SCANNER

Da bi tvoj postojeći Node.js/Express backend (server.ts) mogao da prihvati sliku ili PDF i obradi ga kroz Gemini multimodalni API, moramo kreirati novi endpoint pod nazivom /api/legal/analyze-document.

Korak 1: Izmena na backend-u (server.ts)

Dodaj sledeći kod u svoj server.ts fajl (smesti ga odmah ispod postojećih endpoints, pre funkcije startServer):
typescript
// server.ts - DODATAK ZA SHIFTPULSE DOCUMENT SCANNER
app.post('/api/legal/analyze-document', async (req: Request, res: Response) => {
  try {
    const { base64Data, mimeType } = req.body;

    if (!base64Data || !mimeType) {
       res.status(400).json({ error: 'Base64 podaci i mimeType su obavezni.' });
       return;
    }

    if (!ai) {
      // Fallback režim ako API ključ privremeno nije unet
      res.json({
        success: true,
        contractAnalysis: {
          employerName: "Simulirani Poslodavac d.o.o.",
          detectedRole: "Radnik u proizvodnji",
          baseHourlyRate: 450.00,
          currency: "RSD"
        },
        extractedRules: {
          dailyOvertimeThreshold: 8.0,
          overtimeMultiplier: 1.26,
          nightDiffEnabled: true,
          nightShiftWindow: { start: "22:00", end: "06:00" },
          nightDiffValue: 26.0
        },
        legalComplianceAlerts: [
          "UPOZORENJE: Otkazni rok u ugovoru iznosi 45 dana, što je iznad zakonskog maksimuma od 30 dana u Republici Srbiji.",
          "Zapažanje: Noćni rad je tarifiran sa 26% bonusa u skladu sa Zakonom o radu."
        ]
      });
      return;
    }

    // Sistemska instrukcija koja primorava Gemini da vrati strukturiran JSON kompatibilan sa frontend tipovima
    const systemInstruction = `You are ShiftPulse Legal AI, an expert employment lawyer and labor auditor. 
    Analyze the uploaded document image or PDF (contract or payslip). Extract data into a valid JSON object matching the requested schema. 
    Prioritise checking night differentials, hourly base pay, tax deductions, and labor law anomalies based on regional standards.`;

    const prompt = `Analyze this document and return a strict JSON objects with keys:
    1. 'contractAnalysis' (employerName, detectedRole, baseHourlyRate as float, currency).
    2. 'extractedRules' (dailyOvertimeThreshold, overtimeMultiplier, nightDiffEnabled, nightShiftWindow {start, end}, nightDiffValue as float percentage bonus).
    3. 'legalComplianceAlerts' (array of strings with alerts/warnings regarding labor law violations).
    Return ONLY valid JSON. No markdown wrappers.`;

    const response = await ai.models.generateContent({
      model: 'gemini-2.5-flash', // Odličan i ekonomičan multimodalni model za slike/dokumente
      contents: [
        {
          inlineData: {
            data: base64Data,
            mimeType: mimeType
          }
        },
        { text: prompt }
      ],
      config: {
        systemInstruction,
        responseMimeType: 'application/json', // Garantuje čistu JSON strukturu bez teksta sa strane
        temperature: 0.1
      }
    });

    const resultText = response.text || '{}';
    const parsedData = JSON.parse(resultText);

    res.json({ success: true, ...parsedData });

  } catch (error: any) {
    console.error('Greška u obradi dokumenta:', error);
    res.status(500).json({ error: 'Neuspešna AI analiza dokumenta.', details: error.message });
  }
});
