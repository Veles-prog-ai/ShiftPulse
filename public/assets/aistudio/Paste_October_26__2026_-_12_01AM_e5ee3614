        <p className="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Slikajte ugovor o radu ili platnu listu. Naš AI će automatski izvući platna pravila i proveriti pravnu usklađenost.
        </p>
      </div>

      {/* Upload polje */}
      <div className="relative border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-indigo-500 rounded-xl p-6 text-center cursor-pointer transition-colors bg-slate-50 dark:bg-slate-950/40">
        <input 
          type="file" 
          accept="image/*,application/pdf" 
          onChange={handleFileChange} 
          className="absolute inset-0 opacity-0 cursor-pointer" 
          disabled={loading}
        />
        <Upload className="w-8 h-8 text-slate-400 mx-auto mb-2" />
        <div className="text-xs font-semibold text-slate-700 dark:text-slate-300">
          {loading ? 'AI analizira dokument, sačekajte...' : 'Kliknite da izaberete ili uslikate dokument'}
        </div>
      </div>

      {/* Greška */}
      {error && (
        <div className="p-3 bg-rose-50 dark:bg-rose-950/30 text-rose-600 border border-rose-200 dark:border-rose-900 rounded-lg text-xs">
          {error}
        </div>
      )}

      {/* Rezultati analize */}
      {analysisResult && (
        <div className="space-y-3 animate-fade-in text-xs font-mono">
          <div className="p-3.5 bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-800/60 rounded-xl space-y-2">
            <div className="flex items-center gap-1.5 font-bold text-emerald-800 dark:text-emerald-300">
