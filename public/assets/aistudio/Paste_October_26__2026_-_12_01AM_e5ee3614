// src/context/ShiftContext.tsx - Implementacija unutar ShiftProvider-a

const addJobFromAi = (aiData: any): Job => {
  // 1. Vadimo podatke iz AI "fioka" i postavljamo bezbedne podrazumevane vrednosti (fallbacks)
  const contract = aiData.contractAnalysis || {};
  const rules = aiData.extractedRules || {};

  // Nasumični izbor jedne od tvojih lepih predefinisanih boja za kalendar
  const presetColors = ['#059669', '#6366f1', '#d97706', '#e11d48', '#0284c7'];
  const randomColor = presetColors[Math.floor(Math.random() * presetColors.length)];

  // 2. Sklapamo kompletan Job objekat prateći tvoju types/index.ts strukturu
  const newJobData: Omit<Job, 'id' | 'createdAt'> = {
    name: contract.employerName || 'Novi Poslodavac (AI Sken)',
    role: contract.detectedRole || 'Zaposleni',
    color: randomColor,
    baseHourlyRate: Number(contract.baseHourlyRate) || 0,
    currency: contract.currency || 'RSD',
    payCycle: 'monthly', // Podrazumevani ciklus za naš region, korisnik može menjati
    payPeriodAnchorDate: new Date().toISOString().split('T')[0],
    
    // Automatsko podizanje pravila za rutinske pauze
    routineBreakRules: {
      enabled: true,
      thresholdHours: 5.0,
      durationMinutes: 30,
      isPaid: false,
      autoDeduct: true,
    },

    // Preslikavanje prekovremenog rada iz AI analize
    overtimeRules: {
      enabled: true,
      dailyThresholdHours: Number(rules.dailyOvertimeThreshold) || 8.0,
      dailyOtMultiplier: Number(rules.overtimeMultiplier) || 1.26, // npr. 26% bonus po zakonu
      weeklyThresholdHours: 40.0,
      weeklyOtMultiplier: 1.26,
    },

    // Preslikavanje noćnog rada iz AI analize
    differentialRules: {
      nightDiffEnabled: rules.nightDiffEnabled ?? true,
      nightStartTime: rules.nightShiftWindow?.start || '22:00',
      nightEndTime: rules.nightShiftWindow?.end || '06:00',
      nightDiffType: 'percentage',
      nightDiffValue: Number(rules.nightDiffValue) || 26.0, // 26% je zakonski standard u Srbiji
      weekendBonusMultiplier: 1.0, // none po defaultu
    },

    taxAndDeductions: {
      estimatedTaxRatePercent: 20.0, // Prosek za info-obračun
      fixedDeductionPerPeriod: 0,
    },
  };

  // 3. Pozivamo tvoju već postojeću addJob logiku koja generiše ID i upisuje u localStorage
  return addJob(newJobData);
};
