              <div>Pozicija: <strong className="text-slate-900 dark:text-white">{analysisResult.contractAnalysis.detectedRole}</strong></div>
              <div>Satnica: <strong className="text-slate-900 dark:text-white">{analysisResult.contractAnalysis.baseHourlyRate} {analysisResult.contractAnalysis.currency}/h</strong></div>
              <div>Noćni rad: <strong className="text-indigo-500">+{analysisResult.extractedRules.nightDiffValue}%</strong></div>
            </div>
          </div>

          {/* Pravna upozorenja */}
          {analysisResult.legalComplianceAlerts && analysisResult.legalComplianceAlerts.length > 0 && (
