{
  "name": "shiftpulse-ledger-pro",
  "private": true,
  "version": "1.0.0",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "license:generate": "node generator.js",
    "electron:package": "electron-builder",
    "package:win": "python3 scripts/generate_packages.py windows",
    "package:linux": "python3 scripts/generate_packages.py linux",
    "package:chromeos": "python3 scripts/generate_packages.py chromeos",
    "package:all": "python3 scripts/generate_packages.py all"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/preset-typescript": "^8.0.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.shiftpulse.ledgerpro",
    "productName": "ShiftPulse Ledger Pro",
    "files": [
      "dist/**/*",
      "server.js",
      "package.json",
      "main.js"
    ],
    "files_exclude": [
      "generator.ts",
      "generator.js",
      ".env.local"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.svg"
    }
  }
}
