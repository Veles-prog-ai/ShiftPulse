# ==========================================================
# ShiftPulse Ledger Pro - Production Server Environment (.env)
# ==========================================================

# Server Runtime Configuration (Ubuntu VPS / Node.js / PM2)
PORT=3000
NODE_ENV=production
APP_URL=https://yourdomain.com

# Server-Side Gemini AI API Key (never exposed to browser bundles)
GEMINI_API_KEY=

# B2B License Encryption & Validation
# Private master key used by the issuer to sign/verify AES-256-CBC workstation licenses
LEDGER_MASTER_SECRET=change-this-to-a-strong-64-char-hex-secret

# Optional client workstation license key (format: ivHex:encryptedHex or RSA Base64)
B2B_LICENSE_KEY=
