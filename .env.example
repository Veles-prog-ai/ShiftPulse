# ==========================================================
# ShiftPulse Ledger - Production Server Environment (.env)
# ==========================================================

# Server Runtime Configuration (Ubuntu VPS / Node.js / PM2)
PORT=3000
NODE_ENV=production
APP_URL=https://veles-lab.com
CORS_ALLOWED_ORIGINS=https://veles-lab.com

# Admin Console & Sensitive API Protection (Required for /admin and admin APIs)
ADMIN_SECRET_KEY=

# Server-Side Gemini AI API Key (never exposed to browser bundles)
GEMINI_API_KEY=

# Optional Enterprise BYO-API Server Overrides (used if Enterprise admins configure server defaults)
BYO_AI_ENDPOINT=
BYO_AI_API_KEY=
BYO_AI_MODEL=gemini-4-hydrogen

# B2B License Encryption & Validation
# Private master key used by the issuer to sign/verify AES-256-CBC workstation licenses
LEDGER_MASTER_SECRET=change-this-to-a-strong-64-char-hex-secret
TRIAL_HARDWARE_SALT=change-this-to-a-hardware-binding-salt
SHIFTPULSE_PY_LICENSE_SECRET=ShiftPulse2026Secret

# Optional client workstation license key (format: ivHex:encryptedHex, RSA Base64, or Python signed Base64)
B2B_LICENSE_KEY=

# Stackable B2B Referral Program Configuration
REFERRALS_PER_DISCOUNT_STEP=10
DISCOUNT_PER_STEP_PERCENT=10
MAX_STACKABLE_DISCOUNT_PERCENT=50
REFERRAL_BASE_URL=https://shiftpulse.veles-lab.com


